@startchen
left to right direction
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false

entity 用户 {
  用户编号 <<key>>
  用户名
  密码
  角色
  状态
  头像路径
  创建时间
}

entity 作文 {
  作文编号 <<key>>
  标题
  提交方式
  原始文件路径
  原始内容
  最终内容
  美化内容
  字数
  最终总分
  状态
  创建时间
}

entity 文件 {
  文件编号 <<key>>
  文件名称
  文件类型
  文件路径
  文件大小
  上传时间
}

entity 识别记录 {
  识别编号 <<key>>
  识别版本号
  是否最新
  识别文本
  对比图路径
  识别准确率
  识别引擎
  图片宽度
  图片高度
  文本块总数
  识别时间
}

entity 文本块 {
  文本块编号 <<key>>
  文本块序号
  块文本
  识别置信度
  顶点坐标
  最小横坐标
  最小纵坐标
  最大横坐标
  最大纵坐标
  宽度
  高度
  中心横坐标
  中心纵坐标
}

entity 批改记录 {
  批改编号 <<key>>
  任务编号
  评审提示词
  批改者类型
  批改者编号
  模型版本
  开始时间
  结束时间
  总分
  状态
  失败原因
  重试次数
}

entity 批改细则 {
  细则编号 <<key>>
  细则名称
  批改类型
  适用学段
  提示词模板
  题目要求
  美化等级
  自定义要求
  状态
}

entity 评分维度 {
  维度编号 <<key>>
  维度名称
  权重
  满分值
  评分说明
  排序值
  状态
}

entity 维度评分 {
  评分编号 <<key>>
  权重快照
  实际得分
  生成时间
}

entity 评语建议 {
  建议编号 <<key>>
  建议类型
  建议内容
  起始位置
  结束位置
  关联原文
  生成时间
}

entity 文本纠错 {
  纠错编号 <<key>>
  原始文本片段
  修改后文本片段
  起始位置
  结束位置
  错误类型
  修改建议
  创建时间
  更新时间
  版本号
}

relationship 拥有
relationship 上传
relationship 来源于
relationship 产生
relationship 包含
relationship 生成
relationship 采用
relationship 配置
relationship 形成
relationship 对应
relationship 给出
relationship 提供

拥有 -1- 用户
拥有 -N- 作文

上传 -1- 用户
上传 -N- 文件

来源于 -1- 作文
来源于 -N- 文件

产生 -1- 文件
产生 -N- 识别记录

包含 -1- 识别记录
包含 -N- 文本块

生成 -1- 作文
生成 -N- 批改记录

采用 -N- 批改记录
采用 -1- 批改细则

配置 -1- 批改细则
配置 -N- 评分维度

形成 -1- 批改记录
形成 -N- 维度评分

对应 -1- 评分维度
对应 -N- 维度评分

给出 -1- 批改记录
给出 -N- 评语建议

提供 -1- 批改记录
提供 -N- 文本纠错

@endchen
